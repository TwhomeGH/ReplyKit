        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用回音消除功能！" } }
      }
    },
    "audio.metalNoise.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the GPU for noise reduction to lower CPU usage. Only applies when noise reduction is enabled." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPUでノイズ低減を行い、CPU使用率を下げます。ノイズ低減が有効な場合のみ適用されます。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 GPU 加速降噪處理，降低 CPU 使用率，僅在啟用降噪時生效" } }
      }
    },
    "audio.metalNoise.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Metal Noise Reduction" } },
