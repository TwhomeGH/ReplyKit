{
  "sourceLanguage" : "zh-Hant",
  "strings" : {
    "appIcon.title": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "App 圖示"}}, "en": {"stringUnit": {"state": "translated", "value": "App Icon"}}, "ja": {"stringUnit": {"state": "translated", "value": "Appアイコン"}}}},
    "appIcon.diagnostics": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "圖示診斷"}}, "en": {"stringUnit": {"state": "translated", "value": "Icon Diagnostics"}}, "ja": {"stringUnit": {"state": "translated", "value": "アイコン診断"}}}},
"appIcon.copyDiagnostics": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "複製診斷"}}, "en": {"stringUnit": {"state": "translated", "value": "Copy diagnostics"}}, "ja": {"stringUnit": {"state": "translated", "value": "診断をコピー"}}}},
"appIcon.default": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "預設圖示"}}, "en": {"stringUnit": {"state": "translated", "value": "Default"}}, "ja": {"stringUnit": {"state": "translated", "value": "デフォルト"}}}},
    "appIcon.personal": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "個人精選"}}, "en": {"stringUnit": {"state": "translated", "value": "Personal Favorite"}}, "ja": {"stringUnit": {"state": "translated", "value": "お気に入り"}}}},
    "appIcon.hint": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "選擇內建圖示，或選擇預設圖示恢復。系統可能顯示確認提示。"}}, "en": {"stringUnit": {"state": "translated", "value": "Choose a built-in icon or restore the default. The system may display a confirmation."}}, "ja": {"stringUnit": {"state": "translated", "value": "内蔵アイコンを選択するか、デフォルトに戻せます。システムが確認を表示する場合があります。"}}}},
    "appIcon.changing": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "正在切換圖示…"}}, "en": {"stringUnit": {"state": "translated", "value": "Changing icon…"}}, "ja": {"stringUnit": {"state": "translated", "value": "アイコンを変更中…"}}}},
    "appIcon.unsupported": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "目前環境不支援切換 App 圖示。"}}, "en": {"stringUnit": {"state": "translated", "value": "This environment does not support alternate app icons."}}, "ja": {"stringUnit": {"state": "translated", "value": "この環境ではアイコンの変更に対応していません。"}}}},
    "appIcon.permissionDenied": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "此安裝可能在 KSign 等簽名工具指定了自訂圖示，該設定會覆寫或停用 App 內建的圖示切換。內建圖示只是備用選擇；若要使用 App 內切換，請不要在簽名工具指定自訂圖片，或改用會保留 Info.plist 的安裝方式。"}}, "en": {"stringUnit": {"state": "translated", "value": "This installation may have a custom icon set by a signing tool such as KSign. That setting overrides or disables the app's built-in icon switch. The built-in icon is only a fallback; to use in-app switching, do not set a custom image in the signing tool, or use an install path that preserves Info.plist."}}, "ja": {"stringUnit": {"state": "translated", "value": "このインストールでは KSign などの署名ツールでカスタムアイコンが指定されている可能性があります。その設定はアプリ内のアイコン切り替えを上書きまたは無効にします。内蔵アイコンは代替候補です。アプリ内で切り替えるには、署名ツールでカスタム画像を指定しないか、Info.plist を保持するインストール方法を使用してください。"}}}},
    "appIcon.timeout": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "系統沒有回應圖示切換。請稍後再試；若主畫面圖示已改變但 App 狀態未更新，請重新啟動裝置或重新安裝。"}}, "en": {"stringUnit": {"state": "translated", "value": "The system did not respond to the icon change. Try again later; if the Home Screen icon changed but the app state did not, restart the device or reinstall."}}, "ja": {"stringUnit": {"state": "translated", "value": "システムがアイコン変更に応答しませんでした。時間をおいて再試行してください。ホーム画面のアイコンが変わったのにアプリの状態が更新されない場合は、端末を再起動するか再インストールしてください。"}}}},
    "avLag.title": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "AV Lag 報告"}}, "en": {"stringUnit": {"state": "translated", "value": "AV Lag Report"}}, "ja": {"stringUnit": {"state": "translated", "value": "AV Lag レポート"}}}},
    "avLag.current": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "目前"}}, "en": {"stringUnit": {"state": "translated", "value": "Current"}}, "ja": {"stringUnit": {"state": "translated", "value": "現在"}}}},
    "avLag.purpose": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "用途"}}, "en": {"stringUnit": {"state": "translated", "value": "Purpose"}}, "ja": {"stringUnit": {"state": "translated", "value": "用途"}}}},
    "avLag.report": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "報告"}}, "en": {"stringUnit": {"state": "translated", "value": "Report"}}, "ja": {"stringUnit": {"state": "translated", "value": "レポート"}}}},
    "avLag.open": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "查看目前 AV Lag 報告"}}, "en": {"stringUnit": {"state": "translated", "value": "View Current AV Lag Report"}}, "ja": {"stringUnit": {"state": "translated", "value": "現在の AV Lag レポートを表示"}}}},
    "avLag.empty": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "尚未取樣；開播後每 5 秒更新。"}}, "en": {"stringUnit": {"state": "translated", "value": "No samples yet. Updates every 5 seconds while streaming."}}, "ja": {"stringUnit": {"state": "translated", "value": "まだサンプルがありません。配信中は5秒ごとに更新します。"}}}},
    "avLag.emptyReport": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "尚未取得影片 A/V 取樣。"}}, "en": {"stringUnit": {"state": "translated", "value": "No video A/V samples yet."}}, "ja": {"stringUnit": {"state": "translated", "value": "動画の A/V サンプルはまだありません。"}}}},
    "avLag.footer": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "供回放 retime 與內容延遲診斷交叉參考；不是自動修正值。"}}, "en": {"stringUnit": {"state": "translated", "value": "Cross-reference only for replay retiming and content-lag diagnosis; not an automatic correction."}}, "ja": {"stringUnit": {"state": "translated", "value": "再生の retime とコンテンツ遅延診断の照合用です。自動修正値ではありません。"}}}},
    "avLag.usage": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "videoContentAge = 回呼到達時間 - 影片來源 PTS；正數表示影片內容比回呼時間舊。sourcePTSDelta = videoPTS - audioPTS。這份序列只作診斷與回放 retime 的交叉參考，不會自動改寫播放檔案。"}}, "en": {"stringUnit": {"state": "translated", "value": "videoContentAge = callback arrival time minus video source PTS; a positive value means video content is older than the callback. sourcePTSDelta = videoPTS - audioPTS. This series is a diagnostic and replay-retiming reference only; it does not rewrite playback files."}}, "ja": {"stringUnit": {"state": "translated", "value": "videoContentAge はコールバック到着時刻から映像ソース PTS を引いた値です。正の値は映像コンテンツがコールバック時刻より古いことを示します。sourcePTSDelta = videoPTS - audioPTS。この系列は診断と再生 retime の照合用であり、再生ファイルを自動変更しません。"}}}},
    "avLag.queueEmpty": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "佇列為空"}}, "en": {"stringUnit": {"state": "translated", "value": "queue empty"}}, "ja": {"stringUnit": {"state": "translated", "value": "キューは空"}}}},
    "avLag.noJump": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "無"}}, "en": {"stringUnit": {"state": "translated", "value": "none"}}, "ja": {"stringUnit": {"state": "translated", "value": "なし"}}}},
    "avLag.zeroSemantics": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "video queue oldest 顯示「佇列為空」代表目前沒有待處理樣本；content age jump 顯示「無」代表沒有偵測到 ≥1 秒的階梯事件。"}}, "en": {"stringUnit": {"state": "translated", "value": "video queue oldest shows \"queue empty\" when nothing is pending; content age jump shows \"none\" when no ≥1 second step was detected."}}, "ja": {"stringUnit": {"state": "translated", "value": "video queue oldest が「キューは空」なら保留中のサンプルはありません。content age jump が「なし」なら 1 秒以上の段差は検出されていません。"}}}},
    "avLag.copy": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "複製 JSON"}}, "en": {"stringUnit": {"state": "translated", "value": "Copy JSON"}}, "ja": {"stringUnit": {"state": "translated", "value": "JSON をコピー"}}}},
    "avLag.copied": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "已複製"}}, "en": {"stringUnit": {"state": "translated", "value": "Copied"}}, "ja": {"stringUnit": {"state": "translated", "value": "コピーしました"}}}},
    "avLag.share": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "分享 JSON"}}, "en": {"stringUnit": {"state": "translated", "value": "Share JSON"}}, "ja": {"stringUnit": {"state": "translated", "value": "JSON を共有"}}}},
    "avLag.sampleCount": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "%d 筆取樣；每 5 秒一筆，最多保留 2,880 筆／2 MiB。"}}, "en": {"stringUnit": {"state": "translated", "value": "%d samples; one every 5 seconds, up to 2,880 samples / 2 MiB."}}, "ja": {"stringUnit": {"state": "translated", "value": "%d 件のサンプル。5 秒ごとに 1 件、最大 2,880 件／2 MiB を保持します。"}}}},
    "avLag.videoAge": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "影片內容延遲"}}, "en": {"stringUnit": {"state": "translated", "value": "Video content age"}}, "ja": {"stringUnit": {"state": "translated", "value": "映像コンテンツ遅延"}}}},
    "avLag.queue": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "佇列"}}, "en": {"stringUnit": {"state": "translated", "value": "Queue"}}, "ja": {"stringUnit": {"state": "translated", "value": "キュー"}}}},
    "avLag.oldest": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "最舊"}}, "en": {"stringUnit": {"state": "translated", "value": "Oldest"}}, "ja": {"stringUnit": {"state": "translated", "value": "最古"}}}},
    "avLag.sourceDelta": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "來源 PTS 差"}}, "en": {"stringUnit": {"state": "translated", "value": "Source PTS delta"}}, "ja": {"stringUnit": {"state": "translated", "value": "ソース PTS 差"}}}},
    "avLag.samples": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "取樣"}}, "en": {"stringUnit": {"state": "translated", "value": "Samples"}}, "ja": {"stringUnit": {"state": "translated", "value": "サンプル"}}}},
    "appIcon.failed": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "圖示切換失敗"}}, "en": {"stringUnit": {"state": "translated", "value": "Could Not Change Icon"}}, "ja": {"stringUnit": {"state": "translated", "value": "アイコンを変更できませんでした"}}}},
    "appIcon.ok": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "確定"}}, "en": {"stringUnit": {"state": "translated", "value": "OK"}}, "ja": {"stringUnit": {"state": "translated", "value": "OK"}}}},
    "appIcon.selected": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "目前選用"}}, "en": {"stringUnit": {"state": "translated", "value": "Selected"}}, "ja": {"stringUnit": {"state": "translated", "value": "選択中"}}}},
    "preset.quickSelect": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "快速選擇樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Quick Presets"}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットを選択"}}}},
    "preset.builtIn": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "內建樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Built-in"}}, "ja": {"stringUnit": {"state": "translated", "value": "内蔵"}}}},
    "preset.mine": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "我的樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "My Presets"}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセット"}}}},
    "preset.manage": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "管理我的樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Manage My Presets"}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセットを管理"}}}},
    "preset.delete": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "刪除"}}, "en": {"stringUnit": {"state": "translated", "value": "Delete"}}, "ja": {"stringUnit": {"state": "translated", "value": "削除"}}}},
    "preset.saveCurrent": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "將目前 URL 存為樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Save Current URL as Preset"}}, "ja": {"stringUnit": {"state": "translated", "value": "現在の URL をプリセットに保存"}}}},
    "preset.import": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "匯入樣本…"}}, "en": {"stringUnit": {"state": "translated", "value": "Import Presets…"}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットを読み込む…"}}}},
    "preset.export": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "匯出我的樣本…"}}, "en": {"stringUnit": {"state": "translated", "value": "Export My Presets…"}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセットを書き出す…"}}}},
    "preset.saveTitle": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "存為樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Save as Preset"}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットとして保存"}}}},
    "preset.namePlaceholder": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "樣本顯示名稱"}}, "en": {"stringUnit": {"state": "translated", "value": "Preset display name"}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセット表示名"}}}},
    "preset.save": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "儲存"}}, "en": {"stringUnit": {"state": "translated", "value": "Save"}}, "ja": {"stringUnit": {"state": "translated", "value": "保存"}}}},
    "preset.cancel": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "取消"}}, "en": {"stringUnit": {"state": "translated", "value": "Cancel"}}, "ja": {"stringUnit": {"state": "translated", "value": "キャンセル"}}}},
    "preset.saveMessage": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入這個樣本的顯示名稱；只保存 RTMP 網址，不會包含串流金鑰。"}}, "en": {"stringUnit": {"state": "translated", "value": "Enter a display name for this preset. Only the RTMP URL is saved; stream keys are never included."}}, "ja": {"stringUnit": {"state": "translated", "value": "このプリセットの表示名を入力してください。保存されるのは RTMP URL のみで、配信キーは含まれません。"}}}},
    "preset.saved": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "已加入我的樣本。"}}, "en": {"stringUnit": {"state": "translated", "value": "Added to My Presets."}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセットに追加しました。"}}}},
    "preset.saveFailed": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "無法加入樣本；請確認網址，或是否已有相同名稱與網址。"}}, "en": {"stringUnit": {"state": "translated", "value": "Could not add the preset. Check the URL or for a duplicate name and URL."}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットを追加できませんでした。URL または重複を確認してください。"}}}},
    "preset.invalidURL": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "請先輸入有效的 RTMP／RTMPS 網址。"}}, "en": {"stringUnit": {"state": "translated", "value": "Enter a valid RTMP/RTMPS URL first."}}, "ja": {"stringUnit": {"state": "translated", "value": "先に有効な RTMP／RTMPS URL を入力してください。"}}}},
    "preset.keyCleared": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "已切換平台，請重新輸入串流金鑰。"}}, "en": {"stringUnit": {"state": "translated", "value": "Platform changed; re-enter the stream key."}}, "ja": {"stringUnit": {"state": "translated", "value": "プラットフォームを切り替えました。配信キーを再入力してください。"}}}},
    "preset.importResult": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "已匯入 %d 筆，略過 %d 筆。"}}, "en": {"stringUnit": {"state": "translated", "value": "Imported %d, skipped %d."}}, "ja": {"stringUnit": {"state": "translated", "value": "%d 件を読み込み、%d 件をスキップしました。"}}}},
    "preset.exported": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "已匯出我的樣本。"}}, "en": {"stringUnit": {"state": "translated", "value": "Exported My Presets."}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセットを書き出しました。"}}}},
    "preset.exportEmpty": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "還沒有我的樣本可匯出。"}}, "en": {"stringUnit": {"state": "translated", "value": "No custom presets to export yet."}}, "ja": {"stringUnit": {"state": "translated", "value": "書き出せるマイプリセットがありません。"}}}},
    "preset.manager.title": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "我的樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "My Presets"}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセット"}}}},
    "preset.manager.empty": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "還沒有我的樣本。"}}, "en": {"stringUnit": {"state": "translated", "value": "No custom presets yet."}}, "ja": {"stringUnit": {"state": "translated", "value": "マイプリセットはまだありません。"}}}},
    "preset.manager.hint": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "點一下可編輯名稱與網址；向左滑可刪除。"}}, "en": {"stringUnit": {"state": "translated", "value": "Tap to edit the name and URL; swipe left to delete."}}, "ja": {"stringUnit": {"state": "translated", "value": "タップで名前と URL を編集、左スワイプで削除します。"}}}},
    "preset.done": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "完成"}}, "en": {"stringUnit": {"state": "translated", "value": "Done"}}, "ja": {"stringUnit": {"state": "translated", "value": "完了"}}}},
    "preset.edit.title": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "編輯樣本"}}, "en": {"stringUnit": {"state": "translated", "value": "Edit Preset"}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットを編集"}}}},
    "preset.edit.hint": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "只修改這個樣本的名稱與 URL；不會改動目前推流設定。"}}, "en": {"stringUnit": {"state": "translated", "value": "Edits this preset only; current stream settings are unchanged."}}, "ja": {"stringUnit": {"state": "translated", "value": "このプリセットのみ変更します。現在の配信設定は変わりません。"}}}},
    "preset.urlPlaceholder": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "RTMP URL"}}, "en": {"stringUnit": {"state": "translated", "value": "RTMP URL"}}, "ja": {"stringUnit": {"state": "translated", "value": "RTMP URL"}}}},
    "preset.updateFailed": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "無法更新樣本；請確認名稱與 RTMP／RTMPS 網址，且不要與其他樣本重複。"}}, "en": {"stringUnit": {"state": "translated", "value": "Could not update the preset. Check the name and RTMP/RTMPS URL, and avoid duplicates."}}, "ja": {"stringUnit": {"state": "translated", "value": "プリセットを更新できませんでした。名前と RTMP／RTMPS URL、重複を確認してください。"}}}},
    "pipLayout.color.section": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "文字顏色"}}, "en": {"stringUnit": {"state": "translated", "value": "Text Colors"}}, "ja": {"stringUnit": {"state": "translated", "value": "文字色"}}}},
    "pipLayout.color.main": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "主要聊天文字"}}, "en": {"stringUnit": {"state": "translated", "value": "Main Chat Text"}}, "ja": {"stringUnit": {"state": "translated", "value": "メインチャット文字"}}}},
    "pipLayout.color.secondary": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "次要提示文字"}}, "en": {"stringUnit": {"state": "translated", "value": "Secondary Notice Text"}}, "ja": {"stringUnit": {"state": "translated", "value": "セカンダリ通知の文字"}}}},
    "pipLayout.color.footer": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "只影響 PiP 聊天與次要提示；狀態列、現在時間與贊助文字維持固定色。"}}, "en": {"stringUnit": {"state": "translated", "value": "Affects PiP chat and secondary notices only. Status, time, and sponsor text keep their fixed colors."}}, "ja": {"stringUnit": {"state": "translated", "value": "PiP チャットとセカンダリ通知のみに適用されます。ステータス、時刻、スポンサー文字の色は固定です。"}}}},
    "activity.title": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "即時動態 LiveActivity"}}, "en": {"stringUnit": {"state": "translated", "value": "Live Activities"}}, "ja": {"stringUnit": {"state": "translated", "value": "ライブアクティビティ"}}}},
    "activity.enabled": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "啟用即時動態"}}, "en": {"stringUnit": {"state": "translated", "value": "Enable Live Activities"}}, "ja": {"stringUnit": {"state": "translated", "value": "ライブアクティビティを有効にする"}}}},
    "activity.interval": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "摘要更新間隔"}}, "en": {"stringUnit": {"state": "translated", "value": "Summary update interval"}}, "ja": {"stringUnit": {"state": "translated", "value": "概要の更新間隔"}}}},
    "activity.active": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "正在顯示"}}, "en": {"stringUnit": {"state": "translated", "value": "Active"}}, "ja": {"stringUnit": {"state": "translated", "value": "表示中"}}}},
    "activity.inactive": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "目前未顯示"}}, "en": {"stringUnit": {"state": "translated", "value": "Inactive"}}, "ja": {"stringUnit": {"state": "translated", "value": "非表示"}}}},
    "activity.explanation": {"localizations": {"zh-Hant": {"stringUnit": {"state": "translated", "value": "預設每 5 分鐘更新摘要；開播、重連及結束立即更新。計時由系統顯示。背景暫停時更新可能延後；關閉不會停止推流。仍需允許系統的即時動態權限。"}}, "en": {"stringUnit": {"state": "translated", "value": "Summaries update every 5 minutes by default. Start, reconnect and end events update immediately. The system displays elapsed time. Background suspension may delay updates. Disabling does not stop streaming. System permission is required."}}, "ja": {"stringUnit": {"state": "translated", "value": "概要は既定で5分ごとに更新します。開始・再接続・終了時は即時更新し、経過時間はシステムが表示します。バックグラウンドでは更新が遅れる場合があります。無効にしても配信は停止しません。システムの許可が必要です。"}}}},
