  "recording.infoHelp": {
    "localizations": {
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "資料取自完成後的檔案。FPS 為軌道標稱值；影像碼率為軌道估計值。整檔平均包含音訊與封裝；逐段碼率請使用分析功能。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Values come from the completed file. FPS is nominal and video bitrate is estimated. File average includes audio and container overhead. Use analysis for bitrate over time."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "完成したファイルの情報です。FPSは公称値、映像ビットレートは推定値です。全体平均には音声とコンテナ情報も含みます。時間ごとの値は分析で確認できます。"
        }
      }
    }
  },

