    "pipLayout.statusText.warning" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recommended length is 2 to 6 characters, with a maximum of 12. Long text can squeeze the time and viewer badges." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "推奨は2から6文字、最大12文字です。長すぎると時刻や視聴者バッジを圧迫します。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建議 2 到 6 個字，最多 12 個字；太長會擠壓時間與觀眾數徽章。" } }
