  "recording.noVideo": {
    "localizations": {
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "影片沒有可讀取的影像軌。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "No readable video track."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "読み取れる映像トラックがありません。"
        }
