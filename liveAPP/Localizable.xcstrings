    "appLanguage.restartHint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Most SwiftUI screens update immediately. Some system or cached text may update after reopening the app." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "多くのSwiftUI画面はすぐ更新されます。一部のシステム表示やキャッシュされた文字は、アプリ再起動後に反映される場合があります。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "大部分 SwiftUI 畫面會立即更新；少數系統文字或快取文字可能需要重新打開 App 才會刷新。" } }
      }
    },
