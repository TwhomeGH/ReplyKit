  "recording.orientation.help": {
    "localizations": {
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "只影響新錄影；手動方向以原始畫面為準，於停止錄製後套用，不影響推流。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Applies to new recordings only. Manual rotation uses the original pixels and is applied after recording stops; streaming is unchanged."
