        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "繁體中文" } }
      }
    },
    "audio.agc.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically adjusts audio gain." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "音量ゲインを自動調整します。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用後會對音訊進行自動大小增益" } }
      }
    },
    "audio.agc.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Auto Gain" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動音量調整を有効化" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用自動音量調整功能！" } }
      }
    },
    "audio.echoCancellation.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reduces echo and app audio overlap. Original audio can use the built-in echo control." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エコーとアプリ音声の重なりを抑えます。原音声では内蔵エコー制御を使用できます。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用後會對音訊進行回音處理，減少應用音量重疊 [此功能如果使用原始音訊可控制內置回音消除功能]" } }
      }
    },
    "audio.echoCancellation.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Echo Cancellation" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エコー除去を有効化" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用回音消除功能！" } }
      }
    },
    "audio.metalNoise.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the GPU for noise reduction to lower CPU usage. Only applies when noise reduction is enabled." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "GPUでノイズ低減を行い、CPU使用率を下げます。ノイズ低減が有効な場合のみ適用されます。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "使用 GPU 加速降噪處理，降低 CPU 使用率，僅在啟用降噪時生效" } }
      }
    },
    "audio.metalNoise.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Metal Noise Reduction" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Metalノイズ低減を有効化" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用 Metal 加速降噪！" } }
      }
    },
    "audio.noiseReduction.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reduces background noise and improves speech clarity with spectral subtraction." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "スペクトル減算で背景ノイズを抑え、音声の明瞭さを高めます。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用後會對音訊進行降噪處理，減少背景噪聲，提升語音清晰度 頻譜減法去除" } }
      }
    },
    "audio.noiseReduction.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Noise Reduction" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ノイズ低減を有効化" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用降噪功能！" } }
      }
    },
    "audio.original.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Bypasses audio processing and sends the original audio through." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "音声処理を通さず、元の音声をそのまま送ります。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用後忽視音訊處理 直接原封不動送進去" } }
      }
    },
    "audio.original.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use Original Audio" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "原音声を使用" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用原味音訊處理！" } }
      }
    },
    "common.auto" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto" } },
