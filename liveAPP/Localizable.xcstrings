  "encoding.scope": {
    "localizations": {
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "清單為此模式的編碼器回報值；不保證所有 FPS、碼率與尺寸組合均可用。AutoLevel 由系統決定 Level，實際開播仍需驗證。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Options are reported by this encoder mode, not a guarantee for every FPS, bitrate and size combination. AutoLevel lets the system choose the level; encoding is validated at stream startup."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "一覧はこのモードの対応値です。全 FPS・ビットレート・サイズの組み合わせを保証しません。AutoLevel はシステムが決定し、配信開始時に検証します。"
        }
      }
    }
  },
