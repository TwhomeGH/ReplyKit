  "audio.bitrate.help": {
    "localizations": {
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "適用於 ReplayKit 與 ScreenCaptureKit 推流，下次開播生效。自動採用 RTMP 建議碼率，不會依網速即時切換；維持 AAC LC，不影響原生本地錄影。"
        }
      },
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Applies to ReplayKit and ScreenCaptureKit on the next stream. Automatic uses the RTMP recommendation, not live network adaptation. Keeps AAC LC; native local recording is unaffected."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "ReplayKit と ScreenCaptureKit の次回配信から適用。自動は RTMP 推奨値を使用し、通信速度には追従しません。AAC LC を維持し、標準のローカル録画には影響しません。"
        }
      }
    }
  },
