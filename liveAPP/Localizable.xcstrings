    "gpu.bicubic.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Bicubic scaling can preserve more detail than bilinear filtering when resizing images or video." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Bicubicは画像や映像の拡大縮小で、バイリニアより細部を保ちやすい方式です。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "雙三次插值算法經常用於圖像或者影片的縮放，它能比占主導地位的雙線性濾波算法保留更好的細節品質" } }
      }
    },
    "gpu.bicubic.enable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Bicubic" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Bicubicを有効化" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "啟用Bicubic" } }
      }
    },
    "gpu.bilinear.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Default bilinear scaling is stable and smooth, but can soften high-frequency detail." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "標準のバイリニア拡大は安定して滑らかですが、高周波の細部はやや柔らかくなります。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "預設使用：雙線性內插值算法放大後的圖像質量較高，不會出現像素值不連續的的情況。然而此算法具有低通濾波器的性質，使高頻分量受損，所以可能會使圖像輪廓在一定程度上變得模糊" } }
      }
    },
    "gpu.buffer.count" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Buffer Count" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "バッファ数" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "輸入緩衝區數量" } }
      }
    },
    "gpu.buffer.placeholder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter count, -1 = Auto" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "数を入力、-1 = 自動" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "直接輸入數量，-1=自動" } }
      }
    },
    "gpu.buffer.recommendation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Recommended: -1 = Auto. 5 or 10 may use too much memory." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "推奨: -1 = 自動。5や10はメモリ使用量が大きくなる場合があります。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "建議值: -1=自動，5或10 太大可能爆內存" } }
      }
    },
